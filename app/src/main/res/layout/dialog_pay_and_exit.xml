<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirmation de paiement"
        android:textAppearance="@style/TextAppearance.EasyPark.Title"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.EasyPark.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDialogDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Durée : -- min"
                android:textAppearance="@style/TextAppearance.EasyPark.Body"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDialogAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Montant : 0.000 DT"
                android:textAppearance="@style/TextAppearance.EasyPark.Title"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDialogBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solde disponible : 0.000 DT"
                android:textAppearance="@style/TextAppearance.EasyPark.Label"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Le paiement sera prélevé de votre portefeuille EasyPark."
        android:textAppearance="@style/TextAppearance.EasyPark.Label"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
