<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.EasyPark.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Tableau de bord">

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_person"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mon Profil"
            app:tint="?attr/colorOnBackground" />
    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/bottomNavigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Greeting + Date -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bonjour, Agent"
                android:textAppearance="@style/TextAppearance.EasyPark.Title"
                android:textColor="?attr/colorOnBackground" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aujourd'hui"
                android:textAppearance="@style/TextAppearance.EasyPark.Label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="16dp" />

            <!-- Dark Navy Summary Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EasyPark.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/md_theme_light_onBackground"
                app:strokeWidth="0dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Revenu du jour"
                        android:textAppearance="@style/TextAppearance.EasyPark.Label"
                        android:textColor="@color/md_theme_light_secondary" />

                    <TextView
                        android:id="@+id/tvTotalRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.000 DT"
                        android:textAppearance="@style/TextAppearance.EasyPark.Display"
                        android:textColor="@android:color/white"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/md_theme_dark_outline"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvTotalParkedNow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 véhicules garés actuellement"
                        android:textAppearance="@style/TextAppearance.EasyPark.Body"
                        android:textColor="@color/md_theme_dark_secondary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Occupancy Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Occupation"
                android:textAppearance="@style/TextAppearance.EasyPark.Title"
                android:textColor="?attr/colorOnBackground"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="24dp">

                <!-- Voitures Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    style="@style/Widget.EasyPark.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voitures"
                            android:textAppearance="@style/TextAppearance.EasyPark.Label"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvCarParkedNow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 garées"
                            android:textAppearance="@style/TextAppearance.EasyPark.Title"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressCar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:indicatorColor="?attr/colorPrimary"
                            app:trackColor="?attr/colorSurfaceVariant"
                            app:trackCornerRadius="4dp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvCarFreeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 libres • 0 rés. • 0 occ."
                            android:textAppearance="@style/TextAppearance.EasyPark.Label"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Motos Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    style="@style/Widget.EasyPark.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Motos"
                            android:textAppearance="@style/TextAppearance.EasyPark.Label"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvMotoParkedNow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 garées"
                            android:textAppearance="@style/TextAppearance.EasyPark.Title"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressMoto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:indicatorColor="?attr/colorPrimary"
                            app:trackColor="?attr/colorSurfaceVariant"
                            app:trackCornerRadius="4dp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvMotoFreeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 libres • 0 rés. • 0 occ."
                            android:textAppearance="@style/TextAppearance.EasyPark.Label"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Actions Grid -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actions rapides"
                android:textAppearance="@style/TextAppearance.EasyPark.Title"
                android:textColor="?attr/colorOnBackground"
                android:layout_marginBottom="12dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2">

                <!-- Action 1: Add Vehicle -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAddVehicle"
                    style="@style/Widget.EasyPark.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_directions_car"
                            app:tint="?attr/colorPrimary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ajouter une\nvoiture"
                            android:textAlignment="center"
                            android:textAppearance="@style/TextAppearance.EasyPark.Body"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action 2: Present Vehicles -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPresentVehicles"
                    style="@style/Widget.EasyPark.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_people"
                            app:tint="?attr/colorPrimary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voitures\nprésentes"
                            android:textAlignment="center"
                            android:textAppearance="@style/TextAppearance.EasyPark.Body"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action 3: Quick Exit -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQuickExit"
                    style="@style/Widget.EasyPark.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_logout"
                            app:tint="?attr/colorPrimary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sortie\nrapide"
                            android:textAlignment="center"
                            android:textAppearance="@style/TextAppearance.EasyPark.Body"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action 4: Historique -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHistory"
                    style="@style/Widget.EasyPark.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_receipt_long"
                            app:tint="?attr/colorPrimary"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Historique\ndes tickets"
                            android:textAlignment="center"
                            android:textAppearance="@style/TextAppearance.EasyPark.Body"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        style="@style/Widget.EasyPark.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:menu="@menu/menu_bottom_admin" />

</RelativeLayout>
