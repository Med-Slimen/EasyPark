<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.EasyPark.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Espace Client">

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_person"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mon Profil"
            app:tint="?attr/colorOnBackground" />
    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/bottomNavigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenue !"
                android:textAppearance="@style/TextAppearance.EasyPark.Title"
                android:textColor="?attr/colorOnBackground"
                android:layout_marginBottom="16dp" />

            <!-- Balance Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EasyPark.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/md_theme_light_onBackground"
                app:strokeWidth="0dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Solde disponible"
                            android:textAppearance="@style/TextAppearance.EasyPark.Label"
                            android:textColor="@color/md_theme_light_secondary" />

                        <TextView
                            android:id="@+id/tvBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.000 DT"
                            android:textAppearance="@style/TextAppearance.EasyPark.Display"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickRecharge"
                        style="@style/Widget.EasyPark.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recharger"
                        app:icon="@drawable/ic_add" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Active Reservation Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveBanner"
                style="@style/Widget.EasyPark.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:strokeWidth="0dp"
                android:visibility="gone"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_local_parking"
                        app:tint="?attr/colorPrimary"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvBannerSpot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Place A1 en cours"
                            android:textAppearance="@style/TextAppearance.EasyPark.Body"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBannerTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textAppearance="@style/TextAppearance.EasyPark.Label"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActiveReservation"
                        style="@style/Widget.EasyPark.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voir" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Primary Action Button: Réserver une place -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectSpot"
                style="@style/Widget.EasyPark.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Réserver une place"
                app:icon="@drawable/ic_directions_car"
                app:iconGravity="textStart"
                android:layout_marginBottom="24dp" />

            <!-- Availability Cards -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tarifs &amp; Disponibilité"
                android:textAppearance="@style/TextAppearance.EasyPark.Title"
                android:textColor="?attr/colorOnBackground"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    style="@style/Widget.EasyPark.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_directions_car"
                            app:tint="?attr/colorPrimary"
                            android:importantForAccessibility="no"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:id="@+id/tvCarRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2.000 DT / h"
                            android:textAppearance="@style/TextAppearance.EasyPark.Body"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />
                        <TextView
                            android:id="@+id/tvCarSpots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- places"
                            android:textAppearance="@style/TextAppearance.EasyPark.Label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    style="@style/Widget.EasyPark.Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_two_wheeler"
                            app:tint="?attr/colorPrimary"
                            android:importantForAccessibility="no"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:id="@+id/tvMotoRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.000 DT / h"
                            android:textAppearance="@style/TextAppearance.EasyPark.Body"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />
                        <TextView
                            android:id="@+id/tvMotoSpots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- places"
                            android:textAppearance="@style/TextAppearance.EasyPark.Label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        style="@style/Widget.EasyPark.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:menu="@menu/menu_bottom_client" />

</RelativeLayout>
