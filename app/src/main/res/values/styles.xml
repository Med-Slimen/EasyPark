<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Typography Styles -->
    <style name="TextAppearance.EasyPark.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.EasyPark.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.EasyPark.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.EasyPark.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Component Styles -->
    <style name="Widget.EasyPark.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.EasyPark.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.EasyPark.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.EasyPark.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="strokeColor">?attr/colorOutline</item>
    </style>

    <style name="Widget.EasyPark.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_button</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_button</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_button</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_button</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Widget.EasyPark.Chip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipCornerRadius">@dimen/radius_button</item>
    </style>

    <style name="Widget.EasyPark.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurface</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
    </style>

    <style name="Widget.EasyPark.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.EasyPark.Title</item>
        <item name="android:background">?android:attr/colorBackground</item>
    </style>

</resources>
